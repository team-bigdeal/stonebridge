# 앱의 ⚙️ 설정 창에서 입력해도 이 파일에 저장됩니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 브라우저 에이전트 effort (low | medium | high)
ANTHROPIC_EFFORT=low

# 메일 (Gmail 주소 + 앱 비밀번호). 비워 두면 "메일 앱으로 열기" + "회신 붙여넣기"로 진행
SMTP_USER=
SMTP_PASS=

# 화면 테마: system | light | dark (비우면 system)
THEME=

# 시연 모드: 업체 메일 초안의 받는 사람을 모두 이 시연용 주소로 (.test 주소만, 비우면 끔)
DEMO_MAIL_TO=
