{
  "name": "doldari-desktop",
  "version": "1.0.0",
  "description": "돌다리 데스크톱 앱",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac dmg zip --arm64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@rive-app/react-webgl2": "^4.38.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@types/mailparser": "^3.9.0",
    "@xmldom/xmldom": "^0.9.12",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.162",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "docx-preview": "^0.4.1",
    "dotenv": "^18.0.9",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.9.1",
    "imapflow": "^2.10.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "mailparser": "^3.14.1",
    "media-chrome": "^4.19.4",
    "motion": "^14.9.1",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-jsx-parser": "^2.4.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "kr.bigdeal.stonebridge",
    "productName": "StoneBridge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "StoneBridge"
    },
    "artifactName": "stonebridge-${version}-${arch}.${ext}"
  }
}
